function add(a: integer, b: integer) returns integer { return a + b; }
function square(value: integer) returns integer { return value * value; }
function greet(name: text) returns text { return "Hello, " + name; }
create answer = add(20, 22);
create area = square(7);
create message = greet("Phoneal");
print(answer);
print(area);
print(message);
